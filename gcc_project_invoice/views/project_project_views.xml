<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Extend Project Form View with Down Payment & Invoicing Tab -->
  <record id="project_project_view_form_inherit_gcc" model="ir.ui.view">
    <field name="name">project.project.form.inherit.gcc.invoice</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
      
      <!-- Add Financial Configuration Fields -->
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="project_value"/>
        <field name="has_down_payment"/>
        <field name="down_payment_percent" invisible="not has_down_payment"/>
        <field name="down_payment_amount" invisible="not has_down_payment"/>
      </xpath>

      <!-- Add Smart Buttons -->
      <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
        <button name="action_view_invoices" 
                type="object" 
                class="oe_stat_button" 
                icon="fa-file-text-o"
                invisible="invoice_count == 0">
          <field name="invoice_count" widget="statinfo" string="Invoices"/>
        </button>
        <button name="action_view_down_payments" 
                type="object" 
                class="oe_stat_button" 
                icon="fa-money"
                invisible="down_payment_count == 0 and not has_down_payment">
          <field name="down_payment_count" widget="statinfo" string="Down Payments"/>
        </button>
      </xpath>

      <!-- Add Down Payments & Invoicing Notebook Tab -->
      <xpath expr="//notebook" position="inside">
        <page name="gcc_invoicing" string="Down Payments &amp; Invoicing" invisible="not has_down_payment">
          
          <!-- Financial Summary Cards -->
          <div class="row mt-3 mb-3">
            <div class="col-lg-3 col-6">
              <div class="card bg-primary text-white">
                <div class="card-body">
                  <h4 class="card-title">Project Value</h4>
                  <h2 class="text-white">
                    <field name="project_value" nolabel="1" widget="monetary"/>
                  </h2>
                </div>
              </div>
            </div>
            <div class="col-lg-3 col-6">
              <div class="card bg-success text-white">
                <div class="card-body">
                  <h4 class="card-title">Down Payments</h4>
                  <h2 class="text-white">
                    <field name="total_down_payments_received" nolabel="1" widget="monetary"/>
                  </h2>
                  <small>Available: <field name="available_down_payment_balance" nolabel="1" widget="monetary"/></small>
                </div>
              </div>
            </div>
            <div class="col-lg-3 col-6">
              <div class="card bg-info text-white">
                <div class="card-body">
                  <h4 class="card-title">Invoiced</h4>
                  <h2 class="text-white">
                    <field name="total_invoiced_amount" nolabel="1" widget="monetary"/>
                  </h2>
                  <small>Advance Used: <field name="total_advance_deducted" nolabel="1" widget="monetary"/></small>
                </div>
              </div>
            </div>
            <div class="col-lg-3 col-6">
              <div class="card bg-warning text-white">
                <div class="card-body">
                  <h4 class="card-title">Remaining</h4>
                  <h2 class="text-white">
                    <field name="remaining_project_balance" nolabel="1" widget="monetary"/>
                  </h2>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="row mb-3">
            <div class="col-12">
              <button name="action_add_down_payment" 
                      type="object" 
                      class="btn btn-primary">
                <i class="fa fa-plus"/> Add Down Payment
              </button>
              <button name="action_create_invoice" 
                      type="object" 
                      class="btn btn-success ml-2">
                <i class="fa fa-file-text-o"/> Create Invoice
              </button>
            </div>
          </div>

          <!-- Down Payments List -->
          <group string="Down Payments Received">
            <field name="down_payment_ids" nolabel="1">
              <list decoration-muted="state == 'cancelled'" decoration-success="state == 'reconciled'">
                <field name="date_received"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="payment_reference"/>
                <field name="reconciled_amount" widget="monetary" sum="Used"/>
                <field name="remaining_amount" widget="monetary" sum="Available"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'confirmed'"
                       decoration-primary="state == 'reconciled'"
                       decoration-muted="state == 'cancelled'"/>
                <button name="action_confirm" 
                        type="object" 
                        string="Confirm" 
                        class="btn btn-sm btn-primary"
                        invisible="state != 'draft'"/>
                <button name="action_cancel" 
                        type="object" 
                        string="Cancel" 
                        class="btn btn-sm btn-secondary"
                        invisible="state not in ['draft', 'confirmed'] or reconciled_amount > 0"/>
              </list>
            </field>
          </group>

          <!-- Project Invoices -->
          <group string="Project Invoices">
            <field name="invoice_ids" nolabel="1" 
                   domain="[('move_type', '=', 'out_invoice')]"
                   context="{'default_project_id': id, 'default_move_type': 'out_invoice'}">
              <list decoration-info="state == 'draft'" 
                    decoration-success="state == 'posted'"
                    decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="amount_total_signed" widget="monetary" sum="Total"/>
                <field name="advance_payment_deduction" widget="monetary" sum="Advance Used"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancel'"/>
              </list>
            </field>
          </group>

        </page>
      </xpath>

    </field>
  </record>

</odoo>