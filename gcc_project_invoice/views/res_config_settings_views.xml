<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="res_config_settings_view_form_inherit_gcc_project_invoice" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.gcc.project.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <field name="fiscalyear_last_day" position="after">
                <separator string="Project Deduction Accounts"/>
                <group>
                    <field name="advance_received_account_id" string="Advance Received From Customers"/>
                    <field name="retention_receivable_account_id" string="Retention Receivable (10%)"/>
                    <field name="performance_bonds_account_id" string="Performance Bonds Receivable"/>
                    <field name="deduction_against_invoice_account_id" string="Deduction Against Invoice"/>
                </group>
            </field>
        </field>
    </record>
    
</odoo>
