<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Project Down Payment List View -->
  <record id="project_down_payment_view_list" model="ir.ui.view">
    <field name="name">project.down.payment.list</field>
    <field name="model">project.down.payment</field>
    <field name="arch" type="xml">
      <list decoration-muted="state == 'cancelled'" 
            decoration-success="state == 'reconciled'"
            decoration-info="state == 'confirmed'">
        <field name="project_id"/>
        <field name="partner_id"/>
        <field name="date_received"/>
        <field name="amount" widget="monetary" sum="Total"/>
        <field name="payment_reference"/>
        <field name="reconciled_amount" widget="monetary" sum="Used"/>
        <field name="remaining_amount" widget="monetary" sum="Available"/>
        <field name="state" widget="badge" 
               decoration-info="state == 'draft'" 
               decoration-success="state == 'confirmed'"
               decoration-primary="state == 'reconciled'"
               decoration-muted="state == 'cancelled'"/>
      </list>
    </field>
  </record>

  <!-- Project Down Payment Form View -->
  <record id="project_down_payment_view_form" model="ir.ui.view">
    <field name="name">project.down.payment.form</field>
    <field name="model">project.down.payment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_confirm" 
                  string="Confirm" 
                  type="object" 
                  class="btn-primary"
                  invisible="state != 'draft'"/>
          <button name="action_set_to_draft" 
                  string="Set to Draft" 
                  type="object"
                  invisible="state == 'draft' or reconciled_amount > 0"/>
          <button name="action_cancel" 
                  string="Cancel" 
                  type="object"
                  invisible="state not in ['draft', 'confirmed'] or reconciled_amount > 0"/>
          <button name="action_create_payment_entry" 
                  string="Create Payment" 
                  type="object" 
                  class="btn-secondary"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,reconciled"/>
        </header>

        <sheet>
          <div class="oe_title">
            <h1>
              <field name="display_name" readonly="1"/>
            </h1>
          </div>

          <group>
            <group name="main_info">
              <field name="project_id" options="{'no_create': True, 'no_edit': True}"/>
              <field name="partner_id" readonly="1"/>
              <field name="company_id" readonly="1" groups="base.group_multi_company"/>
              <field name="amount" widget="monetary"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group name="payment_info">
              <field name="date_received"/>
              <field name="payment_reference"/>
              <field name="account_move_id" readonly="1" invisible="not account_move_id"/>
              <field name="account_payment_id" readonly="1" invisible="not account_payment_id"/>
            </group>
          </group>

          <group name="reconciliation_info">
            <group>
              <field name="reconciled_amount" widget="monetary" readonly="1"/>
              <field name="remaining_amount" widget="monetary" readonly="1"/>
            </group>
          </group>

          <field name="description" placeholder="Additional notes about this down payment..."/>

          <notebook>
            <page name="reconciliations" string="Invoice Reconciliations" invisible="not invoice_reconciliation_ids">
              <field name="invoice_reconciliation_ids" readonly="1">
                <list>
                  <field name="invoice_id"/>
                  <field name="amount" widget="monetary"/>
                  <field name="date_reconciled" widget="datetime"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>

        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>

  <!-- Actions -->
  <record id="action_project_down_payment" model="ir.actions.act_window">
    <field name="name">Down Payments</field>
    <field name="res_model">project.down.payment</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first down payment!
      </p>
      <p>
        Track down payments received from customers for projects. 
        Down payments can be automatically deducted from project invoices.
      </p>
    </field>
  </record>

  <!-- Menu Items -->
  <menuitem id="menu_project_down_payment"
            name="Down Payments"
            parent="project.menu_main_pm"
            action="action_project_down_payment"
            sequence="15"/>

</odoo>