<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_move_form_inherit_gcc_project_invoice" model="ir.ui.view">
    <field name="name">account.move.form.inherit.gcc.project.invoice</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <group string="Project / Deductions" name="gcc_project_deductions" invisible="move_type != 'out_invoice'">
          
          <!-- Project Information -->
          <group name="project_info" string="Project Information">
            <field name="project_id" 
                   options="{'no_create': True}"
                   domain="[('partner_id', '=', partner_id)]"
                   context="{'default_partner_id': partner_id}"/>
            <field name="auto_deduct_down_payment" invisible="not project_id"/>
            <field name="available_down_payment" 
                   invisible="not project_id"
                   widget="monetary"
                   readonly="1"/>
            <field name="down_payment_to_deduct" 
                   invisible="not project_id or not auto_deduct_down_payment"
                   widget="monetary"/>
          </group>
          
          <!-- Contract References -->
          <group name="contract_refs" string="References">
            <field name="contract_ref" placeholder="e.g. MC-21323"/>
            <field name="po_ref" placeholder="PO No"/>
            <field name="invoice_ref" placeholder="Inv Ref"/>
            <field name="covered_period" optional="show"/>
          </group>
          
          <!-- Manual Deductions -->
          <group name="manual_deductions" string="Manual Deductions">
            <field name="advance_payment_deduction"/>
            <field name="penalties_deductions"/>
            <field name="performance_bond_amount"/>
            <field name="retention_percent"/>
            <field name="retention_amount"/>
          </group>
          
          <!-- Financial Summary -->
          <group string="Summary" name="gcc_summary">
            <field name="gross_untaxed" readonly="1"/>
            <field name="deductions_total" readonly="1"/>
            <field name="tax_base_after_deductions" readonly="1"/>
            <field name="amount_tax" readonly="1"/>
            <field name="amount_total" readonly="1"/>
            <field name="retention_amount" readonly="1"/>
            <field name="net_collect_now" readonly="1"/>
          </group>
          
        </group>
        
        <!-- Project Financial Status (only show when project selected) -->
        <group string="Project Financial Status" 
               name="project_status" 
               invisible="not project_id or move_type != 'out_invoice'">
          <group string="Project Overview" colspan="4">
            <field name="project_id" readonly="1" nolabel="1" 
                   widget="many2one_link" 
                   options="{'no_create': True, 'no_edit': True}"/>
          </group>
          <group string="Financial Summary" colspan="4">
            <group>
              <label for="project_value" string="Project Value"/>
              <field name="project_value" related="project_id.project_value" readonly="1" widget="monetary"/>
              <label for="total_invoiced_amount" string="Already Invoiced"/>  
              <field name="total_invoiced_amount" related="project_id.total_invoiced_amount" readonly="1" widget="monetary"/>
            </group>
            <group>
              <label for="available_down_payment_balance" string="Down Payment Balance"/>
              <field name="available_down_payment_balance" related="project_id.available_down_payment_balance" readonly="1" widget="monetary"/>
              <label for="remaining_project_balance" string="Remaining Balance"/>
              <field name="remaining_project_balance" related="project_id.remaining_project_balance" readonly="1" widget="monetary"/>
            </group>
          </group>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
