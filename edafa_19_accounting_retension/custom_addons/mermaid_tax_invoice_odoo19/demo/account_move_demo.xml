<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo Customer 1: Construction Company -->
        <record id="demo_partner_construction" model="res.partner">
            <field name="name">Al-Majd Construction Co.</field>
            <field name="street">King Fahd Road</field>
            <field name="city">Riyadh</field>
            <field name="zip">11564</field>
            <field name="country_id" ref="base.sa"/>
            <field name="vat">310123456789003</field>
            <field name="phone">+966 11 234 5678</field>
            <field name="email">finance@almajd-construction.sa</field>
        </record>

        <!-- Demo Customer 2: Trading Company -->
        <record id="demo_partner_trading" model="res.partner">
            <field name="name">Gulf Trading Est.</field>
            <field name="street">Prince Sultan Street</field>
            <field name="city">Jeddah</field>
            <field name="zip">23234</field>
            <field name="country_id" ref="base.sa"/>
            <field name="vat">300987654321003</field>
            <field name="phone">+966 12 654 3210</field>
            <field name="email">accounts@gulftrading.sa</field>
        </record>

        <!-- Demo Product 1: Consulting Services -->
        <record id="demo_product_consulting" model="product.product">
            <field name="name">Project Management Consulting</field>
            <field name="type">service</field>
            <field name="list_price">5000.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
        </record>

        <!-- Demo Product 2: Construction Materials -->
        <record id="demo_product_materials" model="product.product">
            <field name="name">Premium Construction Materials</field>
            <field name="type">consu</field>
            <field name="list_price">15000.00</field>
            <field name="uom_id" ref="uom.product_uom_ton"/>
        </record>

        <!-- Demo Product 3: Equipment Rental -->
        <record id="demo_product_equipment" model="product.product">
            <field name="name">Heavy Equipment Rental - Monthly</field>
            <field name="type">service</field>
            <field name="list_price">8000.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
        </record>

        <!-- Demo Invoice 1: With Retention (10%) and Performance Bond (5%) -->
        <record id="demo_invoice_with_retention_bond" model="account.move">
            <field name="move_type">out_invoice</field>
            <field name="partner_id" ref="demo_partner_construction"/>
            <field name="invoice_date" eval="(DateTime.today() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="invoice_date_due" eval="(DateTime.today() + timedelta(days=25)).strftime('%Y-%m-%d')"/>
            <field name="x_contract_no">CTR-2025-CONST-001</field>
            <field name="x_retention">10000.00</field>
            <field name="x_performance_bond">5000.00</field>
            <field name="invoice_line_ids" eval="[
                Command.create({
                    'product_id': ref('demo_product_consulting'),
                    'name': 'Project Management Consulting - Phase 1',
                    'quantity': 10.0,
                    'price_unit': 5000.00,
                }),
                Command.create({
                    'product_id': ref('demo_product_materials'),
                    'name': 'Premium Construction Materials - Batch A',
                    'quantity': 5.0,
                    'price_unit': 15000.00,
                }),
            ]"/>
        </record>

        <!-- Demo Invoice 2: With Only Retention (5%) -->
        <record id="demo_invoice_with_retention_only" model="account.move">
            <field name="move_type">out_invoice</field>
            <field name="partner_id" ref="demo_partner_trading"/>
            <field name="invoice_date" eval="(DateTime.today() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="invoice_date_due" eval="(DateTime.today() + timedelta(days=27)).strftime('%Y-%m-%d')"/>
            <field name="x_contract_no">CTR-2025-TRADE-055</field>
            <field name="x_retention">2875.00</field>
            <field name="x_performance_bond">0.00</field>
            <field name="invoice_line_ids" eval="[
                Command.create({
                    'product_id': ref('demo_product_equipment'),
                    'name': 'Heavy Equipment Rental - January 2025',
                    'quantity': 3.0,
                    'price_unit': 8000.00,
                }),
                Command.create({
                    'product_id': ref('demo_product_consulting'),
                    'name': 'Technical Support Services',
                    'quantity': 5.0,
                    'price_unit': 3000.00,
                }),
            ]"/>
        </record>

        <!-- Demo Invoice 3: With Performance Bond Only (3%) -->
        <record id="demo_invoice_with_bond_only" model="account.move">
            <field name="move_type">out_invoice</field>
            <field name="partner_id" ref="demo_partner_construction"/>
            <field name="invoice_date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="invoice_date_due" eval="(DateTime.today() + timedelta(days=29)).strftime('%Y-%m-%d')"/>
            <field name="x_contract_no">CTR-2025-CONST-002</field>
            <field name="x_retention">0.00</field>
            <field name="x_performance_bond">1725.00</field>
            <field name="invoice_line_ids" eval="[
                Command.create({
                    'product_id': ref('demo_product_materials'),
                    'name': 'Premium Construction Materials - Batch B',
                    'quantity': 3.0,
                    'price_unit': 15000.00,
                }),
            ]"/>
        </record>

        <!-- Demo Invoice 4: Standard Invoice (No Retention/Bond) -->
        <record id="demo_invoice_standard" model="account.move">
            <field name="move_type">out_invoice</field>
            <field name="partner_id" ref="demo_partner_trading"/>
            <field name="invoice_date" eval="(DateTime.today()).strftime('%Y-%m-%d')"/>
            <field name="invoice_date_due" eval="(DateTime.today() + timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="x_contract_no">PO-2025-089</field>
            <field name="x_retention">0.00</field>
            <field name="x_performance_bond">0.00</field>
            <field name="invoice_line_ids" eval="[
                Command.create({
                    'product_id': ref('demo_product_consulting'),
                    'name': 'Business Consulting - 1 Month',
                    'quantity': 20.0,
                    'price_unit': 2500.00,
                }),
            ]"/>
        </record>

    </data>
</odoo>
